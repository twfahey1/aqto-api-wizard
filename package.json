{
  "name": "aqto-api-wizard",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i assets/styles.css -o public/build/app.css --minify",
    "build:js": "esbuild assets/app.js --bundle --outfile=public/build/app.js --minify",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i assets/styles.css -o public/build/app.css --watch",
    "watch:js": "esbuild assets/app.js --bundle --outfile=public/build/app.js --watch",
    "watch": "npm run watch:css & npm run watch:js"
  },
  "dependencies": {
    "alpinejs": "^3.14.8",
    "htmx.org": "^1.9.12"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "^3.4.17"
  }
}
