{% extends 'base.html.twig' %}

{% block title %}Aqto API Wizard{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/build/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism.min.css" referrerpolicy="no-referrer" />
{% endblock %}

{% block javascripts %}
    <script src="/build/app.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-json.min.js" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-xml-doc.min.js" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-markup.min.js" referrerpolicy="no-referrer"></script>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b bg-white">
        <div class="mx-auto max-w-6xl px-4 py-4 flex items-center justify-between">
            <div class="font-semibold">Aqto API Wizard</div>
            <div class="text-sm text-slate-600">API Development Tool</div>
        </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-6">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(360px,420px)_1fr] gap-6 items-start">
            <aside class="space-y-6">
                <div class="bg-white rounded-lg border shadow-sm" data-aqto-panel="configs" x-data="window.aqtoCollapsible('configs', true)" x-init="init()">
                    <div class="p-4 border-b flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2 min-w-0">
                            <button
                                type="button"
                                class="p-1 -ml-1 rounded hover:bg-slate-100"
                                data-aqto-panel-toggle
                                @click="toggle()"
                                :aria-expanded="open.toString()"
                                aria-controls="configsPanel"
                                title="Toggle Configs"
                            >
                                <svg data-aqto-panel-icon xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 transition-transform" :class="open ? 'rotate-180' : ''">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.94a.75.75 0 111.08 1.04l-4.24 4.5a.75.75 0 01-1.08 0l-4.24-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                                </svg>
                            </button>
                            <h2 class="font-medium">Configs</h2>
                        </div>
                        <div
                            class="flex items-center gap-3"
                            x-data="{ exportModalOpen: false, configModalOpen: false, toastOpen: false, toastKind: 'success', toastTitle: '', toastMessage: '', toastTimer: null }"
                            @keydown.escape.window="
                                if (configModalOpen) configModalOpen = false;
                                if (exportModalOpen) exportModalOpen = false;
                                if (toastOpen) toastOpen = false;
                            "
                            @config-created.document="configModalOpen = false"
                            @config-updated.document="configModalOpen = false"
                            @config-modal-open.document="configModalOpen = true"
                            @config-modal-close.document="configModalOpen = false"
                            @aqto-toast.document="
                                toastKind = $event.detail.kind || 'success';
                                toastTitle = $event.detail.title || '';
                                toastMessage = $event.detail.message || '';
                                toastOpen = true;
                                if (toastTimer) { clearTimeout(toastTimer); }
                                toastTimer = setTimeout(() => { toastOpen = false; }, 2600);
                            "
                        >
                            <button
                                type="button"
                                class="text-sm text-blue-600 hover:underline"
                                @click="configModalOpen = true"
                                hx-get="{{ path('configs_new') }}"
                                hx-target="#configModalBody"
                                hx-swap="innerHTML"
                            >
                                Create
                            </button>

                            <button
                                type="button"
                                class="text-sm text-blue-600 hover:underline"
                                onclick="window.aqtoFolderCreate && window.aqtoFolderCreate(null)"
                            >
                                New Folder
                            </button>

                            <div
                                x-show="configModalOpen"
                                x-cloak
                                class="fixed inset-0 z-50 flex items-center justify-center p-4"
                            >
                                <div class="absolute inset-0 bg-black/40" @click="configModalOpen = false"></div>
                                <div class="relative w-full max-w-2xl rounded-lg bg-white border shadow-lg max-h-[90vh] overflow-y-auto">
                                    <div id="configModalBody">Loading…</div>
                                </div>
                            </div>

                            <div
                                x-show="toastOpen"
                                x-cloak
                                class="fixed inset-0 z-[60] flex items-center justify-center p-4"
                            >
                                <div class="absolute inset-0 bg-black/30" @click="toastOpen = false"></div>
                                <div class="relative w-full max-w-sm rounded-lg border shadow-lg bg-white">
                                    <div class="p-4">
                                        <div class="text-sm font-medium" :class="toastKind === 'error' ? 'text-red-700' : 'text-emerald-700'" x-text="toastTitle"></div>
                                        <div class="mt-1 text-sm text-slate-700" x-text="toastMessage"></div>
                                        <div class="mt-3 flex justify-end">
                                            <button type="button" class="px-3 py-1.5 text-sm rounded border bg-white hover:bg-slate-50" @click="toastOpen = false">Close</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <button
                                type="button"
                                class="text-sm text-blue-600 hover:underline"
                                @click="exportModalOpen = true"
                                hx-get="{{ path('configs_export_options') }}"
                                hx-target="#exportModalBody"
                                hx-swap="innerHTML"
                            >
                                Export
                            </button>

                            <div
                                x-show="exportModalOpen"
                                x-cloak
                                class="fixed inset-0 z-50 flex items-center justify-center p-4"
                            >
                                <div class="absolute inset-0 bg-black/40" @click="exportModalOpen = false"></div>
                                <div class="relative w-full max-w-xl rounded-lg bg-white border shadow-lg max-h-[90vh] overflow-y-auto">
                                    <div id="exportModalBody">Loading…</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="configsPanel" data-aqto-panel-body class="p-4" x-show="open" x-transition x-cloak>
                        <div class="mb-4">
                            <form
                                class="flex items-center gap-2"
                                hx-post="{{ path('configs_import') }}"
                                hx-target="#importResult"
                                hx-swap="innerHTML"
                                enctype="multipart/form-data"
                            >
                                <input class="block w-full text-sm" type="file" name="file" accept="application/json">
                                <button class="px-3 py-2 text-sm rounded bg-slate-900 text-white hover:bg-slate-800" type="submit">Import</button>
                            </form>
                            <div id="importResult" class="mt-2"></div>
                        </div>

                        <div id="configList">
                            {{ include('partials/config_list.html.twig', { collection: collection }) }}
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-lg border shadow-sm" data-aqto-panel="auth-profiles" x-data="window.aqtoCollapsible('auth-profiles', true)" x-init="init()">
                    <div class="p-4 border-b flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2 min-w-0">
                            <button
                                type="button"
                                class="p-1 -ml-1 rounded hover:bg-slate-100"
                                data-aqto-panel-toggle
                                @click="toggle()"
                                :aria-expanded="open.toString()"
                                aria-controls="authProfilesPanel"
                                title="Toggle Auth Profiles"
                            >
                                <svg data-aqto-panel-icon xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 transition-transform" :class="open ? 'rotate-180' : ''">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.94a.75.75 0 111.08 1.04l-4.24 4.5a.75.75 0 01-1.08 0l-4.24-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                                </svg>
                            </button>
                            <h2 class="font-medium">Auth Profiles</h2>
                        </div>
                        <div
                            class="flex items-center gap-3"
                            x-data="{ authProfileModalOpen: false }"
                            @keydown.escape.window="if (authProfileModalOpen) authProfileModalOpen = false"
                            @auth-profile-created.document="authProfileModalOpen = false"
                            @auth-profile-updated.document="authProfileModalOpen = false"
                            @auth-profile-modal-open.document="authProfileModalOpen = true"
                            @auth-profile-modal-close.document="authProfileModalOpen = false"
                        >
                            <button
                                type="button"
                                class="text-sm text-blue-600 hover:underline"
                                @click="authProfileModalOpen = true"
                                hx-get="{{ path('auth_profiles_new') }}"
                                hx-target="#authProfileModalBody"
                                hx-swap="innerHTML"
                            >
                                Create
                            </button>

                            <div
                                x-show="authProfileModalOpen"
                                x-cloak
                                class="fixed inset-0 z-50 flex items-center justify-center p-4"
                            >
                                <div class="absolute inset-0 bg-black/40" @click="authProfileModalOpen = false"></div>
                                <div class="relative w-full max-w-2xl rounded-lg bg-white border shadow-lg max-h-[90vh] overflow-y-auto">
                                    <div id="authProfileModalBody">Loading…</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="authProfilesPanel" data-aqto-panel-body class="p-4" x-show="open" x-transition x-cloak>
                        <div id="authProfileList">
                            {{ include('partials/auth_profile_list.html.twig', { collection: collection }) }}
                        </div>
                    </div>
                </div>
            </aside>

            <section class="lg:sticky lg:top-6 self-start">
                <div class="bg-white rounded-lg border shadow-sm" data-aqto-panel="response" x-data="window.aqtoCollapsible('response', true)" x-init="init()">
                    <div class="p-4 border-b flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2 min-w-0">
                            <button
                                type="button"
                                class="p-1 -ml-1 rounded hover:bg-slate-100"
                                data-aqto-panel-toggle
                                @click="toggle()"
                                :aria-expanded="open.toString()"
                                aria-controls="responsePanel"
                                title="Toggle Response"
                            >
                                <svg data-aqto-panel-icon xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 transition-transform" :class="open ? 'rotate-180' : ''">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.94a.75.75 0 111.08 1.04l-4.24 4.5a.75.75 0 01-1.08 0l-4.24-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                                </svg>
                            </button>
                            <h2 class="font-medium">Response</h2>
                        </div>
                        <div class="text-sm text-slate-600">Select a config and run it.</div>
                    </div>
                    <div id="responsePanel" data-aqto-panel-body class="p-4" x-show="open" x-transition x-cloak>
                        <div id="executeResult" class="mt-2">
                            <pre class="text-xs overflow-auto"><code class="language-json">{ "ready": true }</code></pre>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>
</div>
{% endblock %}
