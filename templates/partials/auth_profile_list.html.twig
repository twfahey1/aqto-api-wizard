{% if (collection.authProfiles|default([])) is empty %}
    <div class="text-sm text-slate-600">No auth profiles yet. Create one to reuse headers and OAuth credentials.</div>
{% else %}
    <ul class="space-y-2">
        {% for p in collection.authProfiles %}
            <li class="p-2 rounded border bg-slate-50">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <div class="font-medium text-sm truncate">{{ p.name }}</div>
                        <div class="mt-0.5 text-[11px] text-slate-600">
                            <span>{{ (p.headers|default([]))|length }} headers</span>
                            {% if (p.oauth ?? null) is not null and ((p.oauth.tokenUrl ?? '') != '' or (p.oauth.refreshUrl ?? '') != '' or (p.oauth.clientId ?? '') != '') %}
                                <span class="ml-1">• OAuth configured</span>
                            {% endif %}
                        </div>
                    </div>

                    <div class="flex items-center gap-1">
                        <button
                            type="button"
                            class="p-1 rounded border bg-white hover:bg-slate-100"
                            title="Edit"
                            hx-get="{{ path('auth_profiles_edit', {id: p.id}) }}"
                            hx-target="#authProfileModalBody"
                            hx-swap="innerHTML"
                            onclick="var el=document.getElementById('authProfileModalBody'); if(el){el.innerHTML='Loading…';} document.dispatchEvent(new CustomEvent('auth-profile-modal-open'));"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                <path d="M13.586 3.586a2 2 0 112.828 2.828l-8.5 8.5a1 1 0 01-.293.207l-3 1.2a1 1 0 01-1.313-1.313l1.2-3a1 1 0 01.207-.293l8.5-8.5z" />
                                <path d="M11.379 5.793L14.207 8.62" />
                            </svg>
                        </button>

                        <form
                            hx-post="{{ path('auth_profiles_delete', {id: p.id}) }}"
                            hx-target="#authProfileList"
                            hx-swap="innerHTML"
                            hx-confirm="Delete this auth profile? Any configs using it will be detached."
                        >
                            <button
                                type="submit"
                                class="p-1 rounded border bg-white hover:bg-red-50 hover:border-red-200 text-red-700"
                                title="Delete"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                    <path fill-rule="evenodd" d="M8.5 2a1 1 0 00-1 1v1H5a1 1 0 000 2h.293l.854 11.11A2 2 0 008.14 19h3.72a2 2 0 001.993-1.89L14.707 6H15a1 1 0 100-2h-2.5V3a1 1 0 00-1-1h-3zM9.5 4V3h1v1h-1z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        </form>
                    </div>
                </div>
            </li>
        {% endfor %}
    </ul>
{% endif %}
