<div class="space-y-3">
    {% if result.error %}
        <div class="rounded border border-red-200 bg-red-50 p-3 text-sm text-red-900">
            <pre class="whitespace-pre-wrap break-words">{{ result.error }}</pre>
        </div>
    {% else %}
        <div class="flex items-center justify-between gap-4">
            <div class="text-sm">
                <span class="font-medium">Status:</span> {{ result.status }}
                {% if result.contentType %}<span class="text-slate-600">• {{ result.contentType }}</span>{% endif %}
            </div>
        </div>

        {% set lang = formatted.detectedType == 'json' ? 'json' : (formatted.detectedType == 'xml' ? 'xml' : (formatted.detectedType == 'html' ? 'markup' : 'none')) %}
        <pre class="text-xs whitespace-pre-wrap break-words overflow-auto max-h-[70vh]"><code class="language-{{ lang }} whitespace-pre-wrap break-words">{{ formatted.pretty }}</code></pre>
    {% endif %}
</div>
