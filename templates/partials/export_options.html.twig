<div class="p-4">
    <div class="flex items-start justify-between gap-4">
        <div>
            <h3 class="text-base font-medium">Export options</h3>
            <p class="text-sm text-slate-600">Choose whether to include secrets in this export.</p>
        </div>
        <button type="button" class="text-sm text-slate-600 hover:text-slate-900" @click="exportModalOpen = false">Close</button>
    </div>

    <form method="post" action="{{ path('configs_export_download') }}" class="mt-4 space-y-4">
        {% if secrets is empty %}
            <div class="rounded border bg-slate-50 p-3 text-sm text-slate-700">
                No secrets detected. Export will be safe by default.
            </div>
        {% else %}
            <div class="rounded border bg-amber-50 p-3 text-sm text-amber-900">
                Turning these on will include live credentials in the exported file.
            </div>

            <div class="space-y-2">
                {% for s in secrets %}
                    <label class="flex items-start gap-3 rounded border p-3 bg-white">
                        <input type="checkbox" name="includeSecretRefs[]" value="{{ s.secretRef }}" class="mt-1">
                        <div class="min-w-0">
                            <div class="text-sm font-medium truncate">{{ s.configName }} — {{ s.headerName }}</div>
                            <div class="text-xs text-slate-600">{{ s.secretKind }} • {{ s.secretRef }}{% if not s.hasValue %} • (no stored value){% endif %}</div>
                        </div>
                    </label>
                {% endfor %}
            </div>
        {% endif %}

        <div class="flex items-center justify-end gap-2">
            <a href="{{ path('home') }}" class="px-3 py-2 text-sm rounded border bg-white hover:bg-slate-50">Cancel</a>
            <button class="px-3 py-2 text-sm rounded bg-slate-900 text-white hover:bg-slate-800" type="submit">
                Download export
            </button>
        </div>
    </form>
</div>
