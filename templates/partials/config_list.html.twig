{% set _tree = tree|default(null) %}

{% if _tree is empty and (collection.configs is empty) and ((collection.folders|default([])) is empty) %}
    <div class="text-sm text-slate-600">No configs yet. Create one, add a folder, or import an export.</div>
{% else %}
    <ul id="aqtoConfigTree" class="space-y-2" data-aqto-sortable="1" data-folder-id="">
        {% for node in _tree|default([]) %}
            {{ include('partials/config_tree_node.html.twig', { node: node, collection: collection }) }}
        {% endfor %}
    </ul>
{% endif %}
