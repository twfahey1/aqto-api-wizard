<div
    class="p-4"
    x-data="{
        authType: '{{ authType|default('none') }}',
        saveAuth: false,
        bodyMode: '{{ bodyMode|default('none') }}',
        activeEnv: '{{ activeEnv|default('dev') }}',
        bearerToken: '{{ bearerToken|default('') }}',
        apiKeyHeader: '{{ apiKeyHeader|default('X-API-Key') }}',
        apiKeyValue: '{{ apiKeyValue|default('') }}',
        refreshToken: '',
        tokenExpiresAt: '',
        oauthTokenUrl: '{{ oauthTokenUrl|default('') }}',
        oauthRefreshUrl: '{{ oauthRefreshUrl|default('') }}',
        oauthModalOpen: false,
    }"
    @oauth-token-received.window="
        bearerToken = ($event.detail.tokenType === 'bearer' || !$event.detail.tokenType)
            ? $event.detail.accessToken
            : $event.detail.accessToken;
        refreshToken = $event.detail.refreshToken || refreshToken;

        if ($event.detail.expiresIn && Number($event.detail.expiresIn) > 0) {
            tokenExpiresAt = new Date(Date.now() + Number($event.detail.expiresIn) * 1000).toISOString();
        }

        // Avoid clobbering oauthTokenUrl when the modal was used in refresh mode.
        if (($event.detail.mode || 'fetch') !== 'refresh') {
            oauthTokenUrl = $event.detail.tokenUrl || oauthTokenUrl;
            oauthRefreshUrl = $event.detail.refreshUrl || oauthRefreshUrl;
        } else {
            oauthRefreshUrl = $event.detail.tokenUrl || $event.detail.refreshUrl || oauthRefreshUrl;
            oauthTokenUrl = oauthTokenUrl || $event.detail.refreshUrl || '';
        }
        activeEnv = $event.detail.applyEnv || activeEnv;
        oauthModalOpen = false;
    "
>
    <div class="flex items-start justify-between gap-4">
        <div>
            <h3 class="text-base font-medium">Edit config</h3>
            <p class="text-sm text-slate-600">Update request settings, URLs, auth, and body.</p>
        </div>
        <button type="button" class="text-sm text-slate-600 hover:text-slate-900" @click="configModalOpen = false">Close</button>
    </div>

    <form
        class="mt-4 space-y-4"
        hx-post="{{ path('configs_update', {id: config.id}) }}"
        hx-target="#configList"
        hx-swap="innerHTML"
    >
        <input type="hidden" name="oauthTokenUrl" :value="oauthTokenUrl">
        <input type="hidden" name="oauthRefreshUrl" :value="oauthRefreshUrl">

        <div id="configEditErrors"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div>
                <label class="block text-sm font-medium">Name</label>
                <input name="name" class="mt-1 w-full rounded border px-3 py-2 text-sm" value="{{ config.name }}" required>
            </div>
            <div>
                <label class="block text-sm font-medium">Method</label>
                <select name="method" class="mt-1 w-full rounded border px-3 py-2 text-sm">
                    {% for m in ['GET','POST','PUT','PATCH','DELETE'] %}
                        <option value="{{ m }}" {{ config.request.method == m ? 'selected' : '' }}>{{ m }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div>
                <label class="block text-sm font-medium">Dev URL</label>
                <input name="urlDev" class="mt-1 w-full rounded border px-3 py-2 text-sm" placeholder="https://dev.api.com/v1/resource" value="{{ config.request.urls.dev ?? '' }}">
            </div>
            <div>
                <label class="block text-sm font-medium">Live URL</label>
                <input name="urlLive" class="mt-1 w-full rounded border px-3 py-2 text-sm" placeholder="https://api.com/v1/resource" value="{{ config.request.urls.live ?? '' }}">
            </div>
        </div>

        <div>
            <label class="block text-sm font-medium">Default environment</label>
            <select name="activeEnv" class="mt-1 w-full rounded border px-3 py-2 text-sm" x-model="activeEnv">
                <option value="dev">dev</option>
                <option value="live">live</option>
            </select>
            <div class="mt-1 text-xs text-slate-600">Dev/Live URLs are optional; you must provide at least one.</div>
        </div>

        <div class="rounded border p-3 bg-slate-50">
            <div class="text-sm font-medium">Auth</div>
            <div class="mt-2 grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                    <label class="block text-sm">Reuse saved auth profile</label>
                    <select name="authProfileId" class="mt-1 w-full rounded border px-3 py-2 text-sm">
                        <option value="">(none)</option>
                        {% for p in authProfiles %}
                            <option value="{{ p.id }}" {{ (config.request.authProfileId ?? '') == p.id ? 'selected' : '' }}>{{ p.name }}</option>
                        {% endfor %}
                    </select>
                    <div class="mt-1 text-xs text-slate-600">If set, inline auth below is ignored.</div>
                </div>

                <div>
                    <label class="block text-sm">Inline auth</label>
                    <select name="authType" class="mt-1 w-full rounded border px-3 py-2 text-sm" x-model="authType">
                        <option value="none">None</option>
                        <option value="bearer">Bearer token</option>
                        <option value="apiKey">API key header</option>
                    </select>
                </div>
            </div>

            <div class="mt-3" x-show="authType === 'bearer'" x-cloak>
                <div class="flex items-end justify-between gap-3">
                    <div class="flex-1 min-w-0">
                        <label class="block text-sm">Bearer token</label>
                        <input name="bearerToken" x-model="bearerToken" class="mt-1 w-full rounded border px-3 py-2 text-sm" placeholder="Paste token, or fetch via OAuth">
                        <div class="mt-1 text-xs text-slate-600">Stored as an Authorization header on the auth profile/request.</div>

                        <div class="mt-2 flex items-center gap-2" x-show="oauthTokenUrl || oauthRefreshUrl" x-cloak>
                            <div class="text-xs text-slate-700">
                                <span class="font-medium">OAuth</span>
                                <template x-if="tokenExpiresAt">
                                    <span>
                                        — Expires <span class="font-mono" x-text="new Date(tokenExpiresAt).toLocaleString()"></span>
                                    </span>
                                </template>
                            </div>

                            <button
                                type="button"
                                class="p-1.5 rounded border bg-white hover:bg-slate-100"
                                title="Refresh token"
                                @click="oauthModalOpen = true"
                                hx-get="{{ path('oauth_token_modal') }}"
                                :hx-vals="JSON.stringify({ applyEnv: activeEnv, mode: 'refresh', tokenUrl: (oauthRefreshUrl || oauthTokenUrl), refreshUrl: oauthRefreshUrl, refreshToken: refreshToken })"
                                hx-target="#oauthModalBody"
                                hx-swap="innerHTML"
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                    <path fill-rule="evenodd" d="M15.312 11.424a5.5 5.5 0 01-9.201 2.466.75.75 0 011.06-1.06 4 4 0 006.662-1.79h-1.58a.75.75 0 010-1.5h2.75a.75.75 0 01.75.75v2.75a.75.75 0 01-1.5 0v-1.616z" clip-rule="evenodd" />
                                    <path fill-rule="evenodd" d="M4.688 8.576a5.5 5.5 0 019.201-2.466.75.75 0 11-1.06 1.06 4 4 0 00-6.662 1.79h1.58a.75.75 0 010 1.5h-2.75a.75.75 0 01-.75-.75V6.96a.75.75 0 011.5 0v1.616z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <button
                            type="button"
                            class="px-3 py-2 text-sm rounded border bg-white hover:bg-slate-100"
                            @click="oauthModalOpen = true"
                            hx-get="{{ path('oauth_token_modal') }}"
                            :hx-vals="JSON.stringify({ applyEnv: activeEnv, mode: 'fetch', tokenUrl: oauthTokenUrl, refreshUrl: oauthRefreshUrl })"
                            hx-target="#oauthModalBody"
                            hx-swap="innerHTML"
                        >
                            Fetch token…
                        </button>
                    </div>
                </div>

                <div class="mt-2" x-show="refreshToken" x-cloak>
                    <label class="block text-xs text-slate-600">Refresh token (kept in-memory)</label>
                    <input type="text" x-model="refreshToken" class="mt-1 w-full rounded border px-3 py-2 text-xs font-mono" placeholder="(optional)" />
                </div>

                <div class="mt-2 text-xs text-slate-600" x-show="oauthTokenUrl">
                    Token URL: <span class="font-mono" x-text="oauthTokenUrl"></span>
                </div>
                <div class="mt-1 text-xs text-slate-600" x-show="oauthRefreshUrl">
                    Refresh URL: <span class="font-mono" x-text="oauthRefreshUrl"></span>
                </div>

                <div
                    x-show="oauthModalOpen"
                    x-cloak
                    class="fixed inset-0 z-50 flex items-center justify-center p-4"
                >
                    <div class="absolute inset-0 bg-black/40" @click="oauthModalOpen = false"></div>
                    <div class="relative w-full max-w-2xl rounded-lg bg-white border shadow-lg max-h-[90vh] overflow-y-auto">
                        <div id="oauthModalBody">Loading…</div>
                    </div>
                </div>
            </div>

            <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-3" x-show="authType === 'apiKey'" x-cloak>
                <div>
                    <label class="block text-sm">Header name</label>
                    <input name="apiKeyHeader" class="mt-1 w-full rounded border px-3 py-2 text-sm" x-model="apiKeyHeader">
                </div>
                <div>
                    <label class="block text-sm">Header value</label>
                    <input name="apiKeyValue" class="mt-1 w-full rounded border px-3 py-2 text-sm" x-model="apiKeyValue" placeholder="(optional; can be left blank and filled later)">
                </div>
            </div>

            <div class="mt-3 flex items-center gap-2">
                <input id="saveAuthProfileEdit" type="checkbox" name="saveAuthProfile" value="1" x-model="saveAuth">
                <label for="saveAuthProfileEdit" class="text-sm">Save inline auth as reusable profile</label>
            </div>
            <div class="mt-2" x-show="saveAuth" x-cloak>
                <label class="block text-sm">Auth profile name</label>
                <input name="authProfileName" class="mt-1 w-full rounded border px-3 py-2 text-sm" placeholder="My Auth">
            </div>
        </div>

        <div class="rounded border p-3 bg-slate-50">
            <div class="text-sm font-medium">Body</div>
            <div class="mt-2">
                <select name="bodyMode" class="w-full rounded border px-3 py-2 text-sm" x-model="bodyMode">
                    <option value="none">None</option>
                    <option value="json">JSON</option>
                    <option value="form">Form URL Encoded</option>
                </select>
            </div>

            <div class="mt-3" x-show="bodyMode === 'json'" x-cloak>
                <label class="block text-sm">JSON payload</label>
                <textarea name="jsonBody" rows="6" class="mt-1 w-full rounded border px-3 py-2 text-sm font-mono">{{ jsonBody|default('') }}</textarea>
                <div class="mt-1 text-xs text-slate-600">Stored as text; sent as application/json.</div>
            </div>

            <div class="mt-3" x-show="bodyMode === 'form'" x-cloak>
                <label class="block text-sm">Form fields (one per line: key=value)</label>
                <textarea name="formBody" rows="6" class="mt-1 w-full rounded border px-3 py-2 text-sm font-mono">{{ formBody|default('') }}</textarea>
                <div class="mt-1 text-xs text-slate-600">Sent as application/x-www-form-urlencoded.</div>
            </div>
        </div>

        <div class="flex items-center justify-end gap-2">
            <button type="button" class="px-3 py-2 text-sm rounded border bg-white hover:bg-slate-50" @click="configModalOpen = false">Cancel</button>
            <button class="px-3 py-2 text-sm rounded bg-slate-900 text-white hover:bg-slate-800" type="submit">Save</button>
        </div>
    </form>
</div>
