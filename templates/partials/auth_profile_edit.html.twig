{% set headers = profile.headers|default([]) %}
{% set oauth = (profile.oauth ?? null) is not null ? profile.oauth : {} %}
{% set initRows = [] %}
{% for h in headers %}
    {% set initRows = initRows|merge([
        {
            name: h.name|default(''),
            value: h.value|default(''),
            isSecret: h.isSecret|default(false) ? true : false,
            secretKind: h.secretKind|default('custom'),
            exportPolicy: h.exportPolicy|default('prompt'),
            secretRef: h.secretRef|default(''),
            placeholder: h.placeholder|default('')
        }
    ]) %}
{% endfor %}
{% if initRows is empty %}
    {% set initRows = [{ name: '', value: '', isSecret: false, secretKind: 'custom', exportPolicy: 'prompt', secretRef: '', placeholder: '' }] %}
{% endif %}

<div
    class="p-4"
    data-init-rows="{{ initRows|json_encode|e('html_attr') }}"
    x-data="window.aqtoAuthProfileEditor($el.dataset.initRows)"
>
    <div class="flex items-start justify-between gap-4">
        <div>
            <h3 class="text-base font-medium">Edit auth profile</h3>
            <p class="text-sm text-slate-600">Update reusable headers and OAuth credentials.</p>
        </div>
        <button type="button" class="text-sm text-slate-600 hover:text-slate-900" @click="authProfileModalOpen = false">Close</button>
    </div>

    <form
        class="mt-4 space-y-4"
        hx-post="{{ path('auth_profiles_update', {id: profile.id}) }}"
        hx-target="#authProfileList"
        hx-swap="innerHTML"
    >
        <div id="authProfileEditErrors"></div>

        <div>
            <label class="block text-sm font-medium">Name</label>
            <input name="name" class="mt-1 w-full rounded border px-3 py-2 text-sm" value="{{ profile.name|default('') }}" required>
        </div>

        <div class="rounded border bg-slate-50 p-3">
            <div class="flex items-center justify-between gap-3">
                <div class="text-sm font-medium">Headers</div>
                <button type="button" class="px-2 py-1 text-xs rounded border bg-white hover:bg-slate-100" @click="addRow()">Add header</button>
            </div>

            <div class="mt-2 space-y-2">
                <template x-for="(row, i) in rows" :key="i">
                    <div class="grid grid-cols-12 gap-2 items-start">
                        <div class="col-span-4">
                            <input class="w-full rounded border px-3 py-2 text-sm font-mono" placeholder="Header name" :name="'headersName[]'" x-model="row.name">
                        </div>
                        <div class="col-span-4">
                            <input class="w-full rounded border px-3 py-2 text-sm font-mono" placeholder="Value" :name="'headersValue[]'" x-model="row.value">
                        </div>
                        <div class="col-span-2">
                            <select class="w-full rounded border px-2 py-2 text-sm" x-model="row.secretKind">
                                <option value="custom">custom</option>
                                <option value="bearer">bearer</option>
                                <option value="apiKey">apiKey</option>
                            </select>
                            <input type="hidden" :name="'headersSecretKind[]'" :value="row.secretKind">
                        </div>
                        <div class="col-span-1">
                            <label class="inline-flex items-center gap-2 text-xs text-slate-700 pt-2">
                                <input type="checkbox" class="rounded border" x-model="row.isSecret">
                                <span>Secret</span>
                            </label>
                            <input type="hidden" :name="'headersIsSecret[]'" :value="row.isSecret ? '1' : '0'">
                        </div>
                        <div class="col-span-1 flex justify-end">
                            <button type="button" class="px-2 py-2 text-xs rounded border bg-white hover:bg-slate-100" @click="removeRow(i)" :disabled="rows.length <= 1" title="Remove">✕</button>
                        </div>

                        <input type="hidden" :name="'headersSecretRef[]'" :value="row.secretRef || ''">
                        <input type="hidden" :name="'headersPlaceholder[]'" :value="row.placeholder || ''">

                        <div class="col-span-12 -mt-1" x-show="row.isSecret" x-cloak>
                            <div class="grid grid-cols-12 gap-2">
                                <div class="col-span-4 text-[11px] text-slate-600 pt-1">Export policy</div>
                                <div class="col-span-8">
                                    <select class="w-full rounded border px-2 py-1.5 text-xs" x-model="row.exportPolicy">
                                        <option value="prompt">prompt</option>
                                        <option value="never">never</option>
                                        <option value="always">always</option>
                                    </select>
                                    <input type="hidden" :name="'headersExportPolicy[]'" :value="row.exportPolicy">
                                </div>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        <div class="rounded border bg-slate-50 p-3">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <div class="text-sm font-medium">OAuth (optional)</div>
                    {% if (oauth.accessToken ?? '') != '' %}
                        <div class="mt-1 text-[11px] text-slate-600">
                            Token stored{% if (oauth.expiresAt ?? '') != '' %} • expires <span class="font-mono">{{ oauth.expiresAt }}</span>{% endif %}
                        </div>
                    {% endif %}
                </div>

                <label class="inline-flex items-center gap-2 text-xs text-slate-700">
                    <input type="checkbox" class="rounded border" name="clearToken" value="1">
                    Clear stored token
                </label>
            </div>

            <div class="mt-2 grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                    <label class="block text-sm font-medium">Token URL</label>
                    <input name="oauthTokenUrl" class="mt-1 w-full rounded border px-3 py-2 text-sm" value="{{ oauth.tokenUrl|default('') }}" placeholder="https://example.com/oauth/token">
                </div>
                <div>
                    <label class="block text-sm font-medium">Refresh URL</label>
                    <input name="oauthRefreshUrl" class="mt-1 w-full rounded border px-3 py-2 text-sm" value="{{ oauth.refreshUrl|default('') }}" placeholder="https://example.com/oauth/token">
                </div>
                <div>
                    <label class="block text-sm font-medium">Client ID</label>
                    <input name="oauthClientId" class="mt-1 w-full rounded border px-3 py-2 text-sm" value="{{ oauth.clientId|default('') }}" placeholder="client_id">
                </div>
                <div>
                    <label class="block text-sm font-medium">Client Secret</label>
                    <input type="password" name="oauthClientSecret" class="mt-1 w-full rounded border px-3 py-2 text-sm" value="{{ oauth.clientSecret|default('') }}" placeholder="client_secret">
                </div>
                <div>
                    <label class="block text-sm font-medium">Scope</label>
                    <input name="oauthScope" class="mt-1 w-full rounded border px-3 py-2 text-sm" value="{{ oauth.scope|default('') }}" placeholder="read:all write:all">
                </div>
                <div>
                    <label class="block text-sm font-medium">Audience</label>
                    <input name="oauthAudience" class="mt-1 w-full rounded border px-3 py-2 text-sm" value="{{ oauth.audience|default('') }}" placeholder="https://api.example.com">
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end gap-2">
            <button type="button" class="px-3 py-2 text-sm rounded border bg-white hover:bg-slate-50" @click="authProfileModalOpen = false">Close</button>
            <button class="px-3 py-2 text-sm rounded bg-blue-600 text-white hover:bg-blue-700" type="submit">Save</button>
        </div>
    </form>
</div>
